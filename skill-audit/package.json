{
  "name": "@hungpg/skill-audit",
  "version": "0.9.0",
  "description": "Security auditing CLI for AI agent skills with PII detection and optional compliance heuristics",
  "type": "module",
  "bin": {
    "skill-audit": "dist/index.js"
  },
  "scripts": {
    "build": "node scripts/clean.cjs && npm run typecheck && tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "format:check": "node scripts/check-format.mjs",
    "lint:js": "eslint src scripts --max-warnings 0",
    "postinstall": "node scripts/postinstall.cjs",
    "security:update": "node dist/index.js --update-db",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "scripts",
    "references",
    "examples",
    "rules",
    "README.md",
    "SKILL.md"
  ],
  "keywords": [
    "security",
    "audit",
    "cli",
    "ai",
    "agent",
    "skills",
    "vulnerability",
    "owasp",
    "prompt-injection",
    "llm-security"
  ],
  "author": "Nuno Marques (https://github.com/nfma)",
  "contributors": [
    "Hung Pham (https://github.com/harrypham2000)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nfma/skill-audit.git"
  },
  "bugs": {
    "url": "https://github.com/nfma/skill-audit/issues"
  },
  "homepage": "https://github.com/nfma/skill-audit#readme",
  "dependencies": {
    "commander": "^14.0.3",
    "gray-matter": "^4.0.3",
    "semver": "^7.5.4"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "js-yaml": "3.15.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "vite": "8.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "10.8.1",
    "eslint-plugin-security": "4.0.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "8.67.0",
    "vitest": "^4.1.0"
  }
}
